# Chave gratuita em https://aistudio.google.com/apikey
GEMINI_API_KEY=sua_chave_aqui

# Opcional: modelo usado na extração (padrão: gemini-3.8-flash).
# Os modelos 1.5 e 2.5 não estão mais disponíveis para novos usuários.
GEMINI_MODEL=gemini-3.5-flash-lite

# Opcional: modelos reserva, usados se o principal estiver sobrecarregado (503) ou indisponível (404)
GEMINI_MODELOS_RESERVA=gemini-3.8-flash

# Opcional: timeout de cada chamada em segundos (padrão: 15)
GEMINI_TIMEOUT=15

# Opcional: tempo máximo somando todas as tentativas (padrão: 25)
GEMINI_PRAZO_TOTAL=25

# Opcional: nível de raciocínio nos modelos Gemini 3+ (minimal | low | medium | high; padrão: low)
GEMINI_THINKING=low
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_MODELOS_RESERVA=gemini-3.8-flash