# Chave gratuita em https://aistudio.google.com/apikey
GEMINI_API_KEY=sua_chave_aqui

# Modelo principal e modelos reserva (separados por vírgula)
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_MODELOS_RESERVA=gemini-3.8-flash
 
# Timeout de cada chamada e tempo máximo somando todas as tentativas (segundos)
GEMINI_TIMEOUT=25
GEMINI_PRAZO_TOTAL=40
 
# Tentativas por modelo em erros 500/502/503 e espera inicial do backoff (segundos)
GEMINI_TENTATIVAS=2
GEMINI_ESPERA=1.5
 
# Nível de raciocínio nos modelos Gemini 3+ (minimal | low | medium | high)
GEMINI_THINKING=minimal
 
# Mostrar os dados entendidos e esperar "sim" antes do primeiro cálculo (1 = sim, 0 = não)
PEDIR_CONFIRMACAO=1
 
# Dias de trabalho por mês, usado em "horas por dia"
DIAS_TRABALHO_MES=22